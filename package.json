{
  "name": "dsh-fingerprint-signature",
  "version": "0.1.0",
  "description": "Human verification gate and context variables for DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check": "npm run build:client && node --check index.js && node --check client.js && node --check scripts/build-client.mjs",
    "test": "node --test",
    "verify": "npm run check && npm test",
    "prepack": "npm run verify"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "_docs"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.0",
    "dsh-better-sidebar": ">=0.10.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": { "optional": true }
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": { "node": ">=20.11" },
  "license": "MIT",
  "keywords": ["deepseek", "harness", "dsh", "dsh-plugin", "human-approval", "webauthn"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  }
}
